{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".tmp-tests",
    // node16 + no `type: module` in package.json means CommonJS output, which is what
    // `node --test` can run directly from .tmp-tests.
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts"]
}
