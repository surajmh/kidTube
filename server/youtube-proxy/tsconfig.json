{
  "compilerOptions": {
    "target": "es2022",
    // The Workers runtime is fetch-compatible; the DOM lib is the closest built-in
    // approximation and avoids pulling in @cloudflare/workers-types for one file.
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
